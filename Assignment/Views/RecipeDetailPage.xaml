<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:Assignment.Converters"
             x:Class="Assignment.Views.RecipeDetailPage"
             Title="📖 食谱详情"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}">

    <ContentPage.Resources>
        <converters:ListToStringConverter x:Key="ListToStringConverter"/>

        <Style x:Key="CardStyle" TargetType="Frame">
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"/>
            <Setter Property="HasShadow" Value="True"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="Label">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="Margin" Value="0,15,0,5"/>
        </Style>

        <Style x:Key="NutriValue" TargetType="Label">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="TextColor" Value="{StaticResource Primary}"/>
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="5">

            <Frame Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                    <Label Text="🍽️" FontSize="48" HorizontalOptions="Center"
                           SemanticProperties.Description="食谱图标"/>
                    <Label Text="{Binding Recipe.Name}" 
                           FontSize="28" 
                           FontAttributes="Bold" 
                           HorizontalOptions="Center"
                           x:Name="RecipeNameLabel"
                           SemanticProperties.HeadingLevel="Level1"/>
                    <Label Text="{Binding Recipe.Category}" 
                           FontSize="16" 
                           HorizontalOptions="Center"
                           TextColor="{StaticResource Primary}"/>
                </VerticalStackLayout>
            </Frame>

            <Frame Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="📊 营养成分 (每份)" 
                           Style="{StaticResource SectionTitle}"
                           HorizontalOptions="Center"
                           SemanticProperties.HeadingLevel="Level2"/>
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" 
                          ColumnDefinitions="*,*" 
                          RowSpacing="10"
                          ColumnSpacing="20">
                        <Label Text="🔥 热量:" Grid.Row="0" Grid.Column="0" FontSize="16"/>
                        <Label Text="{Binding Recipe.Calories, StringFormat='{0:F0} kcal'}" 
                               Grid.Row="0" Grid.Column="1" 
                               Style="{StaticResource NutriValue}"/>

                        <Label Text="🥩 蛋白质:" Grid.Row="1" Grid.Column="0" FontSize="16"/>
                        <Label Text="{Binding Recipe.Protein, StringFormat='{0:F1} g'}" 
                               Grid.Row="1" Grid.Column="1" 
                               Style="{StaticResource NutriValue}"/>

                        <Label Text="🧈 脂肪:" Grid.Row="2" Grid.Column="0" FontSize="16"/>
                        <Label Text="{Binding Recipe.Fat, StringFormat='{0:F1} g'}" 
                               Grid.Row="2" Grid.Column="1" 
                               Style="{StaticResource NutriValue}"/>

                        <Label Text="🍚 碳水:" Grid.Row="3" Grid.Column="0" FontSize="16"/>
                        <Label Text="{Binding Recipe.Carbs, StringFormat='{0:F1} g'}" 
                               Grid.Row="3" Grid.Column="1" 
                               Style="{StaticResource NutriValue}"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <Frame Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="🛒 食材清单" Style="{StaticResource SectionTitle}"
                           SemanticProperties.HeadingLevel="Level2"/>
                    <Label Text="{Binding Recipe.Ingredients, Converter={StaticResource ListToStringConverter}}" 
                           FontSize="16" 
                           LineBreakMode="WordWrap"/>
                </VerticalStackLayout>
            </Frame>

            <Frame Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="👩‍🍳 制作步骤" Style="{StaticResource SectionTitle}"
                           SemanticProperties.HeadingLevel="Level2"/>
                    <Label Text="{Binding Recipe.Instructions, Converter={StaticResource ListToStringConverter}}" 
                           FontSize="16" 
                           LineBreakMode="WordWrap"/>
                </VerticalStackLayout>
            </Frame>

            <Button Text="🏠 返回首页" 
                    Clicked="OnBackClicked" 
                    BackgroundColor="{StaticResource Primary}" 
                    TextColor="White"
                    CornerRadius="25"
                    HeightRequest="50"
                    HorizontalOptions="Center"
                    WidthRequest="200"
                    Margin="0,20,0,10"
                    SemanticProperties.Description="返回食谱厨房主页"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>