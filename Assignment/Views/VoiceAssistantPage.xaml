<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Assignment.Views.VoiceAssistantPage"
             Title="Voice Assistant"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}">
    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="Voice Reader" FontSize="24" FontAttributes="Bold"
               SemanticProperties.HeadingLevel="Level1" x:Name="PageTitle"/>
        <Label Text="Enter text to read" FontAttributes="Bold" SemanticProperties.HeadingLevel="Level2"/>
        <Editor Text="{Binding TextToSpeak}" HeightRequest="150" AutoSize="TextChanges"
                SemanticProperties.Description="Enter text to be read aloud"/>
        <Label Text="Volume" />
        <Slider Minimum="0" Maximum="1" Value="{Binding SpeechVolume}"
                SemanticProperties.Description="Adjust reading volume"/>
        <Label Text="Pitch" />
        <Slider Minimum="0.5" Maximum="2" Value="{Binding SpeechPitch}"
                SemanticProperties.Description="Adjust reading pitch"/>
        <Button Text="Read" Command="{Binding SpeakCommand}" HorizontalOptions="Center"
                SemanticProperties.Description="Start reading entered text"/>
        <Button Text="Cancel" Command="{Binding CancelCommand}" HorizontalOptions="Center"
                SemanticProperties.Description="Stop reading"/>
        <Button Text="Back" Clicked="OnBackClicked" BackgroundColor="Gray" HorizontalOptions="Center"
                SemanticProperties.Description="Return to home page"/>
    </VerticalStackLayout>
</ContentPage>