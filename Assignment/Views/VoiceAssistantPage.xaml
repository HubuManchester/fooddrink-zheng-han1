<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Assignment.Views.VoiceAssistantPage"
             Title="语音助手"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}">
    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="语音朗读助手" FontSize="24" FontAttributes="Bold"
               SemanticProperties.HeadingLevel="Level1" x:Name="PageTitle"/>
        <Label Text="输入要朗读的文本" FontAttributes="Bold" SemanticProperties.HeadingLevel="Level2"/>
        <Editor Text="{Binding TextToSpeak}" HeightRequest="150" AutoSize="TextChanges"
                SemanticProperties.Description="在此输入要朗读的文本"/>
        <Label Text="音量" />
        <Slider Minimum="0" Maximum="1" Value="{Binding SpeechVolume}"
                SemanticProperties.Description="调节朗读音量"/>
        <Label Text="音调" />
        <Slider Minimum="0.5" Maximum="2" Value="{Binding SpeechPitch}"
                SemanticProperties.Description="调节朗读音调"/>
        <Button Text="朗读" Command="{Binding SpeakCommand}" HorizontalOptions="Center"
                SemanticProperties.Description="开始朗读输入的文字"/>
        <Button Text="取消" Command="{Binding CancelCommand}" HorizontalOptions="Center"
                SemanticProperties.Description="停止朗读"/>
        <Button Text="返回" Clicked="OnBackClicked" BackgroundColor="Gray" HorizontalOptions="Center"
                SemanticProperties.Description="返回主页"/>
    </VerticalStackLayout>
</ContentPage>