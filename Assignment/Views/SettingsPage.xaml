<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Assignment.Views.SettingsPage"
             Title="Settings">
    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="Dark Mode" FontAttributes="Bold"/>
        <Switch x:Name="DarkModeSwitch" Toggled="OnDarkModeToggled" />
        <Button Text="Back" Clicked="OnBackClicked" BackgroundColor="Gray" 
                SemanticProperties.Description="Return to home page"/>
    </VerticalStackLayout>
</ContentPage>