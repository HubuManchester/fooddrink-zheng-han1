<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Assignment.Views.AddEditRecipePage"
             Title="Add/Edit Recipe"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}">

    <VerticalStackLayout Padding="20" Spacing="10">
        <Label Text="Recipe Info" FontSize="24" FontAttributes="Bold"
               SemanticProperties.HeadingLevel="Level1" x:Name="PageTitle"/>

        <Entry x:Name="NameEntry" Placeholder="Recipe name"
               SemanticProperties.Description="Enter recipe name"/>
        <Label x:Name="NameError" Text="Name cannot be empty" IsVisible="False" TextColor="Red" FontSize="Caption"/>

        <Label Text="Ingredients (one per line)" FontAttributes="Bold" SemanticProperties.HeadingLevel="Level2"/>
        <Editor x:Name="IngredientsEditor" Placeholder="2 eggs&#10;pinch of salt"
                SemanticProperties.Description="Each line one ingredient, press enter to add next"/>
        <Label x:Name="IngredientsError" Text="Ingredients cannot be empty" IsVisible="False" TextColor="Red" FontSize="Caption"/>

        <Label Text="Instructions" FontAttributes="Bold" SemanticProperties.HeadingLevel="Level2"/>
        <Editor x:Name="InstructionsEditor" Placeholder="1. ...&#10;2. ..."
                SemanticProperties.Description="One step per line"/>
        <Label x:Name="InstructionsError" Text="Instructions cannot be empty" IsVisible="False" TextColor="Red" FontSize="Caption"/>

        <Picker x:Name="CategoryPicker" Title="Select category"
                SemanticProperties.Description="Select recipe category">
            <Picker.Items>
                <x:String>Breakfast</x:String>
                <x:String>Lunch</x:String>
                <x:String>Dinner</x:String>
                <x:String>Dessert</x:String>
            </Picker.Items>
        </Picker>

        <Button Text="Save" Clicked="OnSaveClicked" HorizontalOptions="Center"
                SemanticProperties.Description="Save recipe"/>
        <Button Text="Back" Clicked="OnBackClicked" HorizontalOptions="Center" BackgroundColor="Gray"
                SemanticProperties.Description="Return to home page"/>
    </VerticalStackLayout>
</ContentPage>